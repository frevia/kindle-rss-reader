if(NOT EXISTS "${CRE_SOURCE}/crengine/include/lvdocview.h")
  message(FATAL_ERROR "Pinned CREngine-ng source missing; run python3 tools/build_reader.py host")
endif()
# build_reader.py patches upstream's top-level paths to PROJECT_* paths.
function(rss_add_reader)
  set(CRE_BUILD_SHARED OFF CACHE BOOL "" FORCE)
  set(CRE_BUILD_STATIC ON CACHE BOOL "" FORCE)
  set(OFFLINE_BUILD_MODE ON CACHE BOOL "" FORCE)
  set(DOC_DATA_COMPRESSION_LEVEL 0 CACHE STRING "" FORCE)
  foreach(feature LIBPNG FREETYPE HARFBUZZ LIBUNIBREAK)
    set(WITH_${feature} ON CACHE STRING "" FORCE)
  endforeach()
  foreach(feature LIBJPEG LIBWEBP FRIBIDI ZSTD UTF8PROC)
    set(WITH_${feature} OFF CACHE STRING "" FORCE)
  endforeach()
  # RSS supplies sanitized HTML and cached PNGs, not arbitrary ebook files.
  foreach(feature GIF NANOSVG CHM ANTIWORD FONTCONFIG SHASUM CMARK_GFM MD4C)
    set(USE_${feature} OFF CACHE BOOL "" FORCE)
  endforeach()
  set(ENABLE_UNITTESTING OFF CACHE BOOL "" FORCE)
  set(BUILD_TOOLS OFF CACHE BOOL "" FORCE)
  add_subdirectory("${CRE_SOURCE}" "${CMAKE_CURRENT_BINARY_DIR}/cre")
endfunction()
rss_add_reader()
add_library(crengine ALIAS crengine-ng_static)
pkg_check_modules(CRE_HEADERS REQUIRED IMPORTED_TARGET harfbuzz freetype2 libpng libunibreak)

if(NOT EXISTS "${CRE_SOURCE}/crengine/include/lvdocview.h")
  message(FATAL_ERROR "Pinned CREngine source missing; run python3 tools/build_reader.py host, or configure -DRSS_CRE=OFF for the original renderer")
endif()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(AUTO OFF CACHE STRING "" FORCE)
foreach(feature FreeType HarfBuzz libunibreak libpng zlib)
  string(TOUPPER "${feature}" option)
  set(${option} ON CACHE STRING "" FORCE)
endforeach()
list(APPEND CMAKE_MODULE_PATH "${CRE_SOURCE}/cmake")
add_subdirectory("${CRE_SOURCE}" "${CMAKE_CURRENT_BINARY_DIR}/cre")
pkg_check_modules(CRE_HEADERS REQUIRED IMPORTED_TARGET harfbuzz freetype2 libpng libunibreak)
